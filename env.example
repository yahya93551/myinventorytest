# Environment variables example (do NOT commit secrets)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only credentials for the standalone subscription service.
SUBSCRIPTION_PAYMENT_SERVICE_URL=https://selfless-illumination-production-ec7e.up.railway.app
SUBSCRIPTION_PAYMENT_SERVICE_TOKEN=
# Keep disabled until production checkout is explicitly approved.
SUBSCRIPTION_WAAFIPAY_PRODUCTION_ENABLED=false
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token
