# Environment variables example (do NOT commit secrets)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Set to the independently deployed subscription service URL.
SUBSCRIPTION_PAYMENT_SERVICE_URL=
# Production direct-wallet checkout requires NODE_ENV=production and an explicit
# service-side enable flag. Keep false until production setup and webhook tests finish.
SUBSCRIPTION_WAAFIPAY_PRODUCTION_ENABLED=false
# Use the same random 32+ character secret as SUBSCRIPTION_SERVICE_SHARED_SECRET.
SUBSCRIPTION_PAYMENT_SERVICE_TOKEN=
